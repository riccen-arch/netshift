msgstr "Rescue system (USB stick: the stick system itself is never backed up; the name must match the computer)"

#: netshift-gui.py:815
msgid "Zieltyp:"
msgstr "Target type:"

#: netshift-gui.py:833
msgid "(leer lassen = gespeichertes Passwort behalten)"
msgstr "(leave empty = keep the saved password)"

#: netshift-gui.py:853
msgid "Server-Benutzer ist nicht root (Besitzer/Rechte per --fake-super speichern)"
msgstr "Server user is not root (store owners/permissions via --fake-super)"

#: netshift-gui.py:855
msgid "SSH-Schlüssel erzeugen/anzeigen…"
msgstr "Create/show SSH key…"

#: netshift-gui.py:861
msgid "Pfad, Gerät oder UUID=…:"
msgstr "Path, device or UUID=…:"

#: netshift-gui.py:877
msgid "Ablage:"
msgstr "Storage location:"

#: netshift-gui.py:887
msgid "Automatisch: SMB/NFS/FAT/NTFS → Image-Container (erhält Rechte, Besitzer, Hardlinks); ext4/btrfs/SSH → direkt."
msgstr "Automatic: SMB/NFS/FAT/NTFS → image container (keeps permissions, owners, hard links); ext4/btrfs/SSH → direct."

#: netshift-gui.py:922
msgid "Behalten"
msgstr "Keep"

#: netshift-gui.py:931
msgid "Paketverwaltung (pacman/pamac)"
msgstr "Package management (pacman/pamac)"

#: netshift-gui.py:937
msgid "Snapshot vor jeder Installation/Aktualisierung"
msgstr "Snapshot before every installation/update"

#: netshift-gui.py:940
msgid "Mindestabstand (Minuten):"
msgstr "Minimum interval (minutes):"

#: netshift-gui.py:944
msgid ""
"\n"
"Manuelle Snapshots und Sicherheits-Snapshots vor einer Wiederherstellung werden nie automatisch gelöscht.\n"
"Geplante Snapshots werden nur erstellt, wenn das Ziel erreichbar ist; verpasste Termine werden nachgeholt."
msgstr ""
"\n"
"Manual snapshots and safety snapshots before a restore are never deleted automatically.\n"
"Scheduled snapshots are only created when the target is reachable; missed runs are caught up."

#: netshift-gui.py:952
msgid "Home-Verzeichnisse (/home, /root) mitsichern"
msgstr "Also back up home directories (/home, /root)"

#: netshift-gui.py:954
msgid "Achtung: Wenn aktiviert, setzt eine System-Wiederherstellung auch persönliche Dateien zurück."
msgstr "Caution: if enabled, a system restore also resets personal files."

#: netshift-gui.py:956
msgid "Pacman-Paketcache (/var/cache/pacman/pkg) auslassen"
msgstr "Skip pacman package cache (/var/cache/pacman/pkg)"

#: netshift-gui.py:960
msgid "Mindestens freier Speicher auf dem Ziel (GiB):"
msgstr "Minimum free space on the target (GiB):"

#: netshift-gui.py:963
msgid "Ausschlüsse (rsync-Muster, eines pro Zeile; z.B. /opt/spiele/*  oder  /home/*/Videos/*):"
msgstr "Exclusions (rsync patterns, one per line; e.g. /opt/games/*  or  /home/*/Videos/*):"

#: netshift-gui.py:89
msgid "Willkommen"
msgstr "Welcome"

