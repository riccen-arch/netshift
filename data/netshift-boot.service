[Unit]
Description=netshift: snapshot at system start
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/netshift check --boot
Nice=10
IOSchedulingClass=idle
# Beim Herunterfahren rechtzeitig beenden (Snapshot wird später fortgesetzt)
TimeoutStopSec=30
