<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="org.netshift.gui">
    <description>Manage netshift system snapshots</description>
    <description xml:lang="de">netshift System-Snapshots verwalten</description>
    <message>Administrator rights are required for system snapshots.</message>
    <message xml:lang="de">Für System-Snapshots werden Administratorrechte benötigt.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/netshift/netshift-gtk.py</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="org.netshift.gui.classic">
    <description>Manage netshift system snapshots (classic interface)</description>
    <description xml:lang="de">netshift System-Snapshots verwalten (klassische Oberfläche)</description>
    <message>Administrator rights are required for system snapshots.</message>
    <message xml:lang="de">Für System-Snapshots werden Administratorrechte benötigt.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/netshift/netshift-gui.py</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
